#: templates/eos_auth_monitor/partials/link-badge.html:6
#: templates/eos_auth_monitor/partials/service-icons.html:7
msgid "not linked"
msgstr "не привязано"

#: templates/eos_auth_monitor/account.html:49
msgid "Whether you linked this service. Click to link it in Auth."
msgstr "Привязали ли вы этот сервис. Нажмите, чтобы привязать его в Auth."

#: templates/eos_auth_monitor/account.html:51
msgid ""
"Whether this account linked this service. Click for the Corporation's list "
"of it, for Mumble the main's days."
msgstr ""
"Привязал ли этот аккаунт этот сервис. Нажмите, чтобы открыть список "
"Corporation по нему, для Mumble — дни Main."

