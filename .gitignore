# Python
__pycache__/
*.py[cod]
*$py.class

# Packaging (flit builds into dist/)
build/
dist/
*.egg-info/
.eggs/
wheels/
.pypirc

# Tests and coverage (runtests.py, tox)
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.cache/
# testauth keeps a sqlite database of its own
*.sqlite3
*.sqlite3-journal

# Linters
.mypy_cache/
.ruff_cache/

# Virtual environments and local configuration
venv/
.venv/
env/
.env
.envrc

# Django files that belong to an instance, not to the app
local_settings.py
/static/
/media/

# Translations: the compiled .mo files are shipped with the package, as
# corptools and eveuniverse do - Django does not compile them on install.
# Only makemessages' template is left out.
*.pot

# Logs and leftovers
*.log
*.tmp
*.bak
*.old
*.orig
*.rej

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Claude Code: per-machine settings stay local, CLAUDE.md is tracked
.claude/settings.local.json
